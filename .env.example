# Copy to .env for local development. In Railway, set these under Service → Variables.
# Never commit real values.

# "preview" = noindex + placeholders highlighted (use for the demo)
# "production" = indexable; the build FAILS if any [[PLACEHOLDER]] remains
SITE_MODE=preview

# Canonical origin, no trailing slash
SITE_URL=https://humusolver.com

# Optional: password-protect the whole preview site (any username works)
PREVIEW_PASSWORD=

# Google Apps Script web-app URL that appends leads to the Sheet and emails a notification
# (see scripts/apps-script/README.md)
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# Who receives lead notifications. Demo: your own email. Launch: humusolver@gmail.com
LEAD_NOTIFY_TO=

# "true" publishes the livestock research section (only after owner confirms feed status)
FEATURE_LIVESTOCK_RESEARCH=false
