---
interface Props { items: { name: string; href: string }[]; }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="crumbs">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((c, i) => (
      <li>{i === items.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0 0 1.25rem; padding: 0; font-size: var(--step--1); color: var(--muted); }
  .crumbs li + li::before { content: '/'; margin-right: 0.35rem; color: var(--line); }
  .crumbs a { color: var(--muted); }
</style>
