---
// Simplified mark based on the original Humusolver logo (leaf above soil, roots below).
interface Props { light?: boolean; }
const { light = false } = Astro.props;
---
<span class:list={['logo', { 'logo--light': light }]}>
  <svg class="logo__mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <circle cx="24" cy="24" r="23" fill="#2f4a2c" />
    <path d="M1.5 26h45A23 23 0 0 1 24 47 23 23 0 0 1 1.5 26Z" fill="#3a2e23" />
    <path d="M24 26V15" stroke="#e3ebdc" stroke-width="2.4" stroke-linecap="round" />
    <path d="M24 17c0-5.5 4.2-9.4 11-9.6-.2 6.8-4.5 10.6-11 9.6Z" fill="#8fc46a" />
    <path d="M24 20c-.4-4.6-3.7-7.6-9.2-7.8.2 5.5 3.6 8.5 9.2 7.8Z" fill="#b7dc8f" />
    <path d="M24 26v8m0-4-4.5 5m4.5-2 5 5.5M24 34l-1.5 6M20 31l-5 1.5m14.5-2L34 32" stroke="#c8962e" stroke-width="1.8" stroke-linecap="round" fill="none" />
  </svg>
  <span class="logo__word">Humusolver</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55rem; color: var(--topsoil); }
  .logo__mark { width: 2.4rem; height: 2.4rem; }
  .logo__word {
    font-family: var(--font-head);
    font-weight: 850;
    font-style: italic;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .logo--light { color: #fff; }
</style>
