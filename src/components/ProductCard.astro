---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Ph from './Ph.astro';
import type { CollectionEntry } from 'astro:content';
interface Props { product: CollectionEntry<'products'>; }
const { product } = Astro.props;
const p = product.data;
---
<article class="card product-card">
  <div class="card__media">
    <Image src={p.image} alt={p.imageAlt} widths={[400, 700]} sizes="(min-width: 900px) 34vw, 100vw" />
  </div>
  <p class="pill">{p.form}</p>
  <h3><a href={`/products/${product.id}/`}>{p.name}</a></h3>
  <p>{p.tagline}.</p>
  <dl class="product-card__facts">
    {p.rates.slice(0, 2).map((r) => (<div><dt>{r.use}</dt><dd>{r.rate}</dd></div>))}
    <div><dt>Sizes</dt><dd>{p.packages.map((pk) => pk.size).join(' · ')}</dd></div>
    <div><dt>Starting at</dt><dd><Ph text={p.packages[0].price} /> <span class="muted">({p.packages[0].size})</span></dd></div>
  </dl>
  <div class="btn-row">
    <a class="btn" href={`/quote/?product=${product.id}`}>Get a quote <Icon name="arrow" /></a>
    <a class="btn btn--ghost" href={`/products/${product.id}/`} aria-label={`Details: ${p.name}`}>Details</a>
  </div>
</article>
<style>
  .product-card { display: flex; flex-direction: column; }
  .product-card h3 a { color: inherit; text-decoration: none; }
  .product-card h3 a:hover { color: var(--humus); text-decoration: underline; }
  .product-card .pill { align-self: flex-start; margin-bottom: 0.6rem; }
  .product-card__facts { margin: 0 0 1.25rem; display: grid; gap: 0.5rem; font-size: 0.97rem; }
  .product-card__facts div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px dashed var(--line); }
  .product-card__facts dt { font-weight: 700; color: var(--muted); }
  .product-card__facts dd { margin: 0; }
  .muted { color: var(--muted); }
  .product-card .btn-row { margin-top: auto; }
</style>
