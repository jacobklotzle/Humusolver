---
import type { CollectionEntry } from 'astro:content';
interface Props { study: CollectionEntry<'research'>; headingLevel?: 'h3' | 'h4'; }
const { study, headingLevel = 'h3' } = Astro.props;
const s = study.data;
const H = headingLevel;
const resultLabel = { positive: '', mixed: 'Mixed results', none: 'No effect found' }[s.result];
---
<article class="card study" id={study.id}>
  <p class="study__meta">
    <span class="pill">{s.studyType}</span>
    {resultLabel && <span class="pill pill--null">{resultLabel}</span>}
    {s.openAccess && <span class="pill pill--oa">Free to read</span>}
  </p>
  <H class="study__title"><a href={s.url} rel="noopener" target="_blank">{s.title}<span class="sr-only"> (opens in new tab)</span></a></H>
  <p class="study__cite">{s.authors} ({s.year}). <em>{s.journal}</em>.</p>
  <p class="study__finding"><strong>What they found:</strong> {s.finding}</p>
  <p class="study__conditions"><strong>Study conditions:</strong> {s.conditions}</p>
</article>
<style>
  .study { display: flex; flex-direction: column; gap: 0.25rem; }
  .study__meta { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.5rem; }
  .pill--null { background: #f3e1d6; color: #7a3f1c; }
  .pill--oa { background: #e7eef8; color: #1d4a80; }
  .study__title { font-size: 1.1rem; line-height: 1.3; margin: 0 0 0.35rem; }
  .study__title a { color: var(--topsoil); }
  .study__title a:hover { color: var(--humus); }
  .study__cite { font-size: 0.92rem; color: var(--muted); margin-bottom: 0.6rem; }
  .study__finding, .study__conditions { font-size: 0.97rem; margin-bottom: 0.5rem; }
  .study__conditions { color: var(--muted); }
</style>
