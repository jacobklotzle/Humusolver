---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from './Breadcrumbs.astro';
interface Props {
  eyebrow?: string; title: string; lede?: string;
  image?: ImageMetadata; imageAlt?: string;
  crumbs?: { name: string; href: string }[];
}
const { eyebrow, title, lede, image, imageAlt = '', crumbs } = Astro.props;
---
<section class="page-hero">
  <div class:list={['wrap', 'page-hero__inner', { 'page-hero__inner--media': image }]}>
    <div>
      {crumbs && <Breadcrumbs items={crumbs} />}
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
    {image && (
      <Image src={image} alt={imageAlt} widths={[480, 800, 1100]} sizes="(min-width: 900px) 45vw, 100vw"
        loading="eager" fetchpriority="high" class="page-hero__img" />
    )}
  </div>
</section>
<style>
  .page-hero { padding-block: clamp(2rem, 1.5rem + 3vw, 4.5rem) clamp(2rem, 1.5rem + 2.5vw, 3.5rem); background: linear-gradient(180deg, var(--paper), var(--cream)); border-bottom: 1px solid var(--line); }
  .page-hero__inner { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 900px) { .page-hero__inner--media { grid-template-columns: 1.1fr 1fr; gap: 3.5rem; } }
  .page-hero h1 { max-width: 20ch; }
  .page-hero .lede { margin-bottom: 0; }
  .page-hero__img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow); }
</style>
