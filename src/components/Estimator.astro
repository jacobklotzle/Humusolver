---
// Acreage → pounds → package estimator. Data comes from the product content files,
// so changing a rate or package size there updates the calculator automatically.
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);

// Turn "5–10 lb per acre" / "1–2 oz per acre" into numeric lb/acre ranges.
function parseRate(rate: string) {
  const m = rate.match(/([\d.]+)\s*[–-]\s*([\d.]+)\s*(lb|oz)/i) ?? rate.match(/([\d.]+)()\s*(lb|oz)/i);
  if (!m) return null;
  const k = m[3].toLowerCase() === 'oz' ? 1 / 16 : 1;
  const lo = Number(m[1]) * k;
  const hi = Number(m[2] || m[1]) * k;
  return { lo, hi };
}
const parseLb = (size: string) => Number(size.replace(/,/g, '').match(/([\d.]+)\s*lb/i)?.[1] ?? 0);

const data = products.map((p) => ({
  id: p.id,
  name: p.data.name,
  rates: p.data.rates
    .map((r) => ({ use: r.use, label: r.rate, ...parseRate(r.rate) }))
    .filter((r) => r.lo !== undefined && /acre/i.test(r.label)),
  packages: p.data.packages.map((pk) => ({ size: pk.size, lb: parseLb(pk.size) })).filter((pk) => pk.lb > 0),
}));
---
<div class="estimator card" data-products={JSON.stringify(data)}>
  <div class="estimator__head">
    <span class="estimator__icon"><Icon name="calc" /></span>
    <div>
      <h2 id="est-h">How much do I need?</h2>
      <p>Enter your acres to estimate pounds and packages. This uses the general rates on our product pages.</p>
    </div>
  </div>
  <div class="estimator__grid" role="group" aria-labelledby="est-h">
    <div class="field">
      <label for="est-product">Product</label>
      <select id="est-product">
        {data.map((p) => <option value={p.id}>{p.name}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="est-use">Application</label>
      <select id="est-use"></select>
    </div>
    <div class="field">
      <label for="est-acres">Acres</label>
      <input id="est-acres" type="number" inputmode="decimal" min="0" step="any" placeholder="e.g. 160" />
    </div>
  </div>
  <output class="estimator__out" for="est-product est-use est-acres" aria-live="polite">
    <span class="estimator__empty">Enter acres to see an estimate.</span>
  </output>
  <button type="button" class="btn btn--ghost estimator__use" hidden>Use this estimate in my quote <Icon name="arrow" /></button>
  <p class="estimator__fine">This is an estimate only. Final rates depend on your soil and program, so we'll confirm when we call.</p>
</div>

<script>
  type Rate = { use: string; label: string; lo: number; hi: number };
  type Prod = { id: string; name: string; rates: Rate[]; packages: { size: string; lb: number }[] };

  const root = document.querySelector<HTMLElement>('.estimator');
  if (root) {
    const products: Prod[] = JSON.parse(root.dataset.products ?? '[]');
    const prodSel = root.querySelector<HTMLSelectElement>('#est-product')!;
    const useSel = root.querySelector<HTMLSelectElement>('#est-use')!;
    const acresIn = root.querySelector<HTMLInputElement>('#est-acres')!;
    const out = root.querySelector<HTMLOutputElement>('.estimator__out')!;
    const useBtn = root.querySelector<HTMLButtonElement>('.estimator__use')!;
    let summary = '';

    const fmt = (n: number) => (n >= 100 ? Math.round(n).toLocaleString() : n.toLocaleString(undefined, { maximumFractionDigits: 1 }));

    // Fill with the largest packages first, then cover the remainder with the smallest package that fits.
    function suggest(lb: number, pkgs: Prod['packages']) {
      const sorted = [...pkgs].sort((a, b) => b.lb - a.lb);
      const parts: string[] = [];
      let left = lb;
      for (const p of sorted) {
        if (p === sorted[sorted.length - 1]) break;
        const n = Math.floor(left / p.lb);
        if (n > 0 && p.lb >= 50) { parts.push(`${n} × ${p.size}`); left -= n * p.lb; }
      }
      if (left > 0.01) {
        const fit = [...sorted].reverse().find((p) => p.lb >= left) ?? sorted[0];
        const n = Math.ceil(left / fit.lb);
        parts.push(`${n} × ${fit.size}`);
      }
      return parts.join(' + ');
    }

    function fillUses() {
      const p = products.find((x) => x.id === prodSel.value)!;
      useSel.innerHTML = p.rates.map((r, i) => `<option value="${i}">${r.use} (${r.label})</option>`).join('');
      calc();
    }

    function calc() {
      const p = products.find((x) => x.id === prodSel.value)!;
      const r = p.rates[Number(useSel.value) || 0];
      const acres = Number(acresIn.value);
      if (!r || !(acres > 0)) {
        out.innerHTML = '<span class="estimator__empty">Enter acres to see an estimate.</span>';
        useBtn.hidden = true;
        summary = '';
        return;
      }
      const lo = r.lo * acres;
      const hi = r.hi * acres;
      const range = lo === hi ? `${fmt(lo)} lb` : `${fmt(lo)}–${fmt(hi)} lb`;
      const pk = suggest(hi, p.packages);
      out.innerHTML = `<strong class="estimator__big">${range}</strong><span>of ${p.name} for ${fmt(acres)} acres at ${r.label}</span><span class="estimator__pk">Suggested packaging (high rate): ${pk}</span>`;
      summary = `${p.name}: ${range} for ${fmt(acres)} ac (${r.use}, ${r.label}); suggested ${pk}`;
      useBtn.hidden = false;
      useBtn.dataset.product = p.id;
    }

    prodSel.addEventListener('change', fillUses);
    useSel.addEventListener('change', calc);
    acresIn.addEventListener('input', calc);
    useBtn.addEventListener('click', () => {
      root.dispatchEvent(new CustomEvent('estimate', { bubbles: true, detail: { summary, product: prodSel.value, acres: acresIn.value } }));
    });

    const params = new URLSearchParams(location.search);
    const pre = params.get('product');
    if (pre && products.some((p) => p.id === pre)) prodSel.value = pre;
    fillUses();
  }
</script>

<style>
  .estimator { border-top: 5px solid var(--gold); }
  .estimator__head { display: flex; gap: 1rem; align-items: flex-start; margin-bottom: 1.25rem; }
  .estimator__head h2 { font-size: var(--step-2); margin-bottom: 0.25rem; }
  .estimator__head p { margin: 0; color: var(--muted); }
  .estimator__icon { flex: none; display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 14px; background: var(--gold-200); color: var(--topsoil); }
  .estimator__icon :global(svg) { width: 1.5rem; height: 1.5rem; }
  .estimator__grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); }
  .estimator__out {
    display: grid;
    gap: 0.25rem;
    margin-top: 1.25rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--humus-100);
    min-height: 4.5rem;
    align-content: center;
  }
  .estimator__out :global(.estimator__big) { font-family: var(--font-head); font-size: var(--step-3); line-height: 1.1; color: var(--humus-600); }
  .estimator__out :global(.estimator__pk) { font-weight: 600; }
  .estimator__out :global(.estimator__empty) { color: var(--muted); }
  .estimator__use { margin-top: 1rem; }
  .estimator__fine { font-size: var(--step--1); color: var(--muted); margin: 1rem 0 0; }
</style>
