---
import Icon from './Icon.astro';
interface Props { href: string; title: string; summary: string; icon?: any; }
const { href, title, summary, icon = 'sprout' } = Astro.props;
---
<article class="card card--link use-card">
  <span class="use-card__icon"><Icon name={icon} /></span>
  <h3><a href={href}>{title}</a></h3>
  <p>{summary}</p>
  <span class="more" aria-hidden="true">Learn more →</span>
</article>
<style>
  .use-card h3 a { color: inherit; text-decoration: none; }
  .use-card__icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 12px; background: var(--humus-100); color: var(--humus); margin-bottom: 1rem; }
  .use-card__icon :global(svg) { width: 1.4rem; height: 1.4rem; }
  .use-card .more { color: var(--humus); }
</style>
