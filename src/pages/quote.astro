---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Estimator from '../components/Estimator.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';
import { business } from '../site.config';
const crumbs = [{ name: 'Request a quote', href: '/quote/' }];
---
<BaseLayout title="Request a Quote for Humic & Fulvic Acid | Humusolver"
  description="Get pricing on Humusolver for your acres. Choose freight shipping or will-call pickup in Monticello, Indiana. Estimate how much you need in seconds."
  crumbs={crumbs} cta={false}>
  <PageHero eyebrow="Request a quote" title="Get pricing for your operation" crumbs={crumbs}
    lede="Tell us what you grow and how many acres. We'll call you back with product, pricing, and freight or pickup options." />
  <section class="section section--tight">
    <div class="wrap quote-layout">
      <div class="stack">
        <Estimator />
        <div class="card" id="form">
          <h2 class="quote-h">Your quote request</h2>
          <p class="hint" style="margin-bottom:1.5rem">Fields marked <span class="req">*</span> are required.</p>
          <LeadForm type="quote" />
        </div>
      </div>
      <aside class="quote-side stack">
        <div class="card">
          <h2 class="quote-h">What happens next</h2>
          <ol class="next">
            <li>We review your request. <span class="hint">Your details go only to the Humusolver team.</span></li>
            <li>We call or email you to confirm product, rate, and quantity.</li>
            <li>You get a price with freight, or a will-call pickup time.</li>
          </ol>
        </div>
        <div class="card">
          <h2 class="quote-h">Rather talk now?</h2>
          {business.people.map((p) => (
            <p><strong>{p.name}</strong>, {p.role}<br /><a href={p.phoneHref} class="side-phone"><Icon name="phone" /> {p.phone}</a></p>
          ))}
          <p><a href={`mailto:${business.email}`}>{business.email}</a></p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
<style>
  .quote-layout { display: grid; gap: 2rem; }
  @media (min-width: 1000px) { .quote-layout { grid-template-columns: minmax(0, 1fr) 20rem; } .quote-side { position: sticky; top: 6rem; align-self: start; } }
  .quote-h { font-size: var(--step-1); }
  #form { scroll-margin-top: 6rem; }
  .next { padding-left: 1.2rem; margin: 0; display: grid; gap: 0.6rem; }
  .next .hint { display: block; }
  .side-phone { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 700; font-size: 1.1rem; }
  .side-phone :global(svg) { width: 1rem; height: 1rem; }
</style>
