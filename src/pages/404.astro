---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found | Humusolver" description="That page doesn't exist." noindex>
  <section class="section">
    <div class="wrap" style="max-width:44rem">
      <p class="eyebrow">404</p>
      <h1>We couldn't find that page.</h1>
      <p class="lede">It may have moved when we rebuilt the site. Try one of these:</p>
      <div class="btn-row" style="margin-top:1.5rem">
        <a class="btn" href="/">Home</a>
        <a class="btn btn--ghost" href="/products/">Products</a>
        <a class="btn btn--ghost" href="/quote/">Request a quote</a>
      </div>
    </div>
  </section>
</BaseLayout>
